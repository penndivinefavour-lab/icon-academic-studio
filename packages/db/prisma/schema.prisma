// This is your Prisma schema file for ICON Academic Studio
// Uses PostgreSQL for both development and production.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  role          String   @default("USER") // ADMIN | USER
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaces    Workspace[]
  reviewItems   ReviewItem[]

  @@index([email])
  @@map("users")
}

// ============================================================================
// WORKSPACE
// ============================================================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@map("workspaces")
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   // GCE_STUDY_GUIDE, BOOK, THESIS, etc.
  workspaceId   String?
  settings      String   @default("{}") // JSON string
  status        String   @default("DRAFT") // DRAFT, IN_PROGRESS, REVIEW, COMPLETED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  sources       Source[]
  documents     Document[]
  datasets      Dataset[]
  researchNotes ResearchNote[]
  researchQuestions ResearchQuestion[]
  templates     Template[]
  formattingProfiles FormattingProfile[]
  generationJobs GenerationJob[]
  // GCE domain
  pastPapers    PastPaper[]
  syllabi       Syllabus[]
  questionBankItems QuestionBankItem[]
  mockExams     MockExam[]
  academicProjects AcademicProject[]
  academicReferences AcademicReference[]
  // Phase 7: Publishing
  publications     Publication[]
  // Phase 8: AI Intelligence
  aiGenerations    AIGeneration[]
  aiConversations  AIConversation[]

  @@index([workspaceId])
  @@index([type])
  @@map("projects")
}

// ============================================================================
// SOURCES
// ============================================================================

model Source {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  type             String   // PDF, DOCX, TXT, MARKDOWN, CSV, XLSX, IMAGE, WEB, NOTE, MANUAL
  mimeType         String?
  sizeBytes        Int
  filePath         String?
  contentPreview   String?
  metadata         String   @default("{}") // JSON string
  status           String   @default("UPLOADED") // UPLOADED, PROCESSING, PROCESSED, ERROR, DELETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  datasets         Dataset[]
  chunks           SourceChunk[]
  citations        Citation[]
  evidenceItems    EvidenceItem[]
  // GCE domain
  syllabi          Syllabus[]
  markingSchemes   MarkingScheme[]
  pastPapers       PastPaper[]

  // Academic Project Studio domain
  academicAppendices AcademicAppendix[] @relation("AppendixBoundSource")

  @@index([projectId])
  @@index([status])
  @@map("sources")
}

model SourceChunk {
  id         String   @id @default(cuid())
  sourceId   String
  index      Int
  content    String
  metadata   String   @default("{}") // JSON string
  createdAt  DateTime @default(now())

  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_chunks")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id                    String   @id @default(cuid())
  projectId             String
  title                 String
  type                  String   // GENERAL, CHAPTER, SECTION, RESEARCH_REPORT, THESIS, STUDY_GUIDE, etc.
  subtitle              String?
  description           String?
  language              String   @default("en")
  status                String   @default("DRAFT") // DRAFT, REVIEW, EDITED, PROOF, TYPESET, FINAL
  version               Int      @default(1)
  wordCount             Int      @default(0)
  formattingProfileId   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formattingProfile     FormattingProfile? @relation(fields: [formattingProfileId], references: [id])
  sections              DocumentSection[]
  blocks                DocumentBlock[]
  versions              DocumentVersion[]
  reviewItems           ReviewItem[]
  exports               ExportJob[]
  // Academic Project Studio domain
  academicProjects      AcademicProject[]
  // Phase 7: Publishing
  publications          Publication[]

  @@index([projectId])
  @@index([status])
  @@map("documents")
}

model DocumentSection {
  id          String   @id @default(cuid())
  documentId  String
  parentId    String?
  title       String   @default("")
  headingLevel Int     @default(1)
  order       Int      @default(0)
  content     String?
  metadata    String   @default("{}") // JSON string for additional section settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent      DocumentSection? @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    DocumentSection[] @relation("SectionHierarchy")
  blocks      DocumentBlock[]
  // Academic Project Studio domain
  academicChapter  AcademicChapter?
  academicTable   AcademicTableFigure?
  evidenceLinks   EvidenceSectionLink[]
  // Phase 7: Publishing
  publicationChapters PublicationChapter[]
  publicationFigures  PublicationFigure[]
  publicationIndexEntries PublicationIndexEntry[]

  @@index([documentId])
  @@index([order])
  @@map("document_sections")
}

model DocumentBlock {
  id         String   @id @default(cuid())
  documentId String
  sectionId  String?
  type       String   // PARAGRAPH, HEADING, BULLET_LIST, NUMBERED_LIST, QUOTE, TABLE, PAGE_BREAK, CITATION_BLOCK, CALLOUT, IMAGE
  content    String
  order      Int      @default(0)
  metadata   String   @default("{}") // JSON string for block-specific data (e.g., table rows, list items)
  provenance String?  // JSON string: { sourceId, evidenceId, chunkId } where applicable
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  section    DocumentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  // Phase 7: Publishing
  publicationIndexEntries PublicationIndexEntry[]

  @@index([documentId])
  @@index([sectionId])
  @@index([order])
  @@map("document_blocks")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  versionNumber Int
  note        String?
  structure   String   // JSON snapshot of the document at this version
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([versionNumber])
  @@map("document_versions")
}

// ============================================================================
// CITATIONS & REFERENCES
// ============================================================================

model Citation {
  id          String   @id @default(cuid())
  sourceId    String
  author      String?
  year        String?
  title       String?
  url         String?
  doi         String?
  pageRange   String?
  format      String   // INLINE, FOOTNOTE, ENDNOTE, BIBLIOGRAPHY
  raw         String
  verified    Boolean  @default(false)
  context     String?
  createdAt   DateTime @default(now())

  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  academicReferences AcademicReference[]

  @@index([sourceId])
  @@map("citations")
}

// ============================================================================
// RESEARCH
// ============================================================================

model ResearchNote {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  content         String
  tags            String   @default("[]") // JSON array string
  sources         String   @default("[]") // JSON array of source IDs
  linkedDocuments String   @default("[]") // JSON array of document IDs
  // Phase 10: optional idempotency key for mobile capture sync.
  // Lets the Android outbox retry POSTs without creating duplicates.
  // Uniqueness is scoped per project so the same device key can be reused
  // across projects.
  clientId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@index([projectId])
  @@map("research_notes")
}

model ResearchQuestion {
  id          String   @id @default(cuid())
  projectId   String
  question    String
  hypothesis  String?
  status      String   @default("OPEN") // OPEN, INVESTIGATING, ANSWERED, CLOSED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]
  objectiveLinks ObjectiveQuestion[]
  findings        Finding[]

  @@index([projectId])
  @@index([status])
  @@map("research_questions")
}

model EvidenceItem {
  id                 String   @id @default(cuid())
  researchQuestionId String
  sourceId           String
  claim              String
  supportingEvidence String
  strength           String   // STRONG, MODERATE, WEAK, UNCERTAIN
  createdAt          DateTime @default(now())

  researchQuestion   ResearchQuestion @relation(fields: [researchQuestionId], references: [id], onDelete: Cascade)
  source             Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sectionLinks       EvidenceSectionLink[]

  @@index([researchQuestionId])
  @@index([sourceId])
  @@map("evidence_items")
}

// Phase 6 back-relation: evidence linked to academic project sections
model EvidenceSectionLink {
  id          String   @id @default(cuid())
  evidenceId  String
  documentSectionId String
  createdAt   DateTime @default(now())

  evidence    EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  documentSection DocumentSection @relation(fields: [documentSectionId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, documentSectionId])
  @@index([documentSectionId])
  @@map("evidence_section_links")
}

// ============================================================================
// DATASETS & ANALYSIS
// ============================================================================

model Dataset {
  id          String   @id @default(cuid())
  projectId   String
  sourceId    String?
  name        String
  description String?
  originalFilename String?
  storedPath  String?
  format      String   // CSV, XLSX
  rowCount    Int      @default(0)
  columnCount Int      @default(0)
  fileSize    Int      @default(0)
  checksum    String?
  status      String   @default("IMPORTED") // IMPORTED, PROCESSING, PROFILED, ERROR
  profile     String?  // JSON string with profiling results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  columns     DatasetColumn[]
  analyses    Analysis[]
  charts      Chart[]
  tables      Table_[]
  transformations Transformation[]
  resultTransformations Transformation[] @relation("TransformationResult")
  // Phase 6: Data Lab → Academic findings linkage
  findings    Finding[]
  appendices  AcademicAppendix[]

  @@index([projectId])
  @@index([status])
  @@map("datasets")
}

model DatasetColumn {
  id            String   @id @default(cuid())
  datasetId     String
  name          String
  originalName  String?
  index         Int
  inferredType  String   // NUMBER, TEXT, DATE, BOOLEAN, CATEGORICAL
  nullable      Boolean  @default(true)
  uniqueCount   Int      @default(0)
  missingCount  Int      @default(0)
  sampleValues  String   @default("[]") // JSON array
  metadata      String   @default("{}") // JSON string for additional stats
  createdAt     DateTime @default(now())

  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  variables     ResearchVariable[]

  @@index([datasetId])
  @@index([index])
  @@map("dataset_columns")
}

model Analysis {
  id          String   @id @default(cuid())
  datasetId   String
  method      String
  parameters  String   @default("{}") // JSON string
  results     String   @default("{}") // JSON string
  notes       String?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  findings    Finding[]

  @@index([datasetId])
  @@map("analyses")
}

model Chart {
  id          String   @id @default(cuid())
  datasetId   String
  type        String   // BAR, LINE, PIE, etc.
  config      String   @default("{}") // JSON string
  data        String   @default("[]") // JSON array string
  imageUrl    String?
  title       String?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  academicTables AcademicTableFigure[]
  appendices   AcademicAppendix[]
  findings    Finding[]
  publicationFigures PublicationFigure[]

  @@index([datasetId])
  @@map("charts")
}

// ============================================================================
// ACADEMIC PROJECT STUDIO (Phase 6)
// ============================================================================
//
// Reuse-first: chapters are typed views over DocumentSection; instruments,
// findings, conclusions and appendices reference existing Source / Dataset /
// Analysis / Table_ / Chart entities instead of duplicating them.

model AcademicProject {
  id                  String   @id @default(cuid())
  projectId           String
  documentId          String?  // Document Studio document for this project
  title               String
  projectType         String   // HND_PROJECT | THESIS | DISSERTATION | ... | CUSTOM
  institution         String?
  department          String?
  program             String?
  academicLevel       String?  // HND | BACHELOR | MASTER | DOCTORATE | OTHER
  studentName         String?
  registrationNumber  String?
  supervisorName      String?
  academicYear        String?
  status              String   @default("DRAFT") // DRAFT, IN_PROGRESS, REVIEW, SUBMITTED, COMPLETED
  formattingProfileId String?
  citationStyle       String   @default("APA") // APA, MLA, CHICAGO, HARVARD
  metadata            String   @default("{}") // JSON: custom requirements
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document            Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  formattingProfile   FormattingProfile? @relation(fields: [formattingProfileId], references: [id])

  chapters            AcademicChapter[]
  requirements        AcademicRequirement[]
  objectives          AcademicObjective[]
  hypotheses          ResearchHypothesis[]
  variables           ResearchVariable[]
  frameworks          ConceptualFramework[]
  methodologies       Methodology[]
  questionnaires      Questionnaire[]
  interviewGuides     InterviewGuide[]
  findings            Finding[]
  conclusions         Conclusion[]
  recommendations     Recommendation[]
  appendices          AcademicAppendix[]
  frontMatter         FrontMatter[]
  abstracts           AcademicAbstract[]
  tables              AcademicTableFigure[]
  references          AcademicReference[]
  validationRuns      ValidationRun[]
  objectiveQuestions  ObjectiveQuestion[]

  @@index([projectId])
  @@index([documentId])
  @@index([projectType])
  @@map("academic_projects")
}

model AcademicChapter {
  id              String   @id @default(cuid())
  academicProjectId String
  documentSectionId String? @unique // corresponding Document Studio section
  chapterNumber   Int
  title           String
  description     String?
  wordTarget      Int?
  order           Int      @default(0)
  isFrontMatter   Boolean  @default(false)
  isAppendix      Boolean  @default(false)
  required        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicProject AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  documentSection DocumentSection? @relation(fields: [documentSectionId], references: [id], onDelete: SetNull)
  requirements    AcademicRequirement[]
  methodology     Methodology?
  appendices      AcademicAppendix[]

  @@unique([academicProjectId, chapterNumber])
  @@index([academicProjectId])
  @@index([documentSectionId])
  @@map("academic_chapters")
}

model AcademicRequirement {
  id               String   @id @default(cuid())
  academicProjectId String
  chapterId        String?
  category         String   // STRUCTURE | CONTENT | REFERENCE | DATA | FORMATTING
  rule             String   // machine-readable rule key
  parameters       String   @default("{}") // JSON: thresholds, targets, styles
  severity         String   @default("ERROR") // ERROR, WARNING, INFO
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  chapter          AcademicChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([academicProjectId])
  @@index([category])
  @@map("academic_requirements")
}

model AcademicObjective {
  id               String   @id @default(cuid())
  academicProjectId String
  objectiveType    String   // GENERAL, SPECIFIC
  statement        String
  order            Int      @default(0)
  status           String   @default("DRAFT") // DRAFT, AI_GENERATED, USER_EDITED, NEEDS_REVIEW, VERIFIED, APPROVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  questionLinks    ObjectiveQuestion[]
  findings         Finding[]
  conclusions      Conclusion[]

  @@index([academicProjectId])
  @@map("academic_objectives")
}

model ObjectiveQuestion {
  id               String   @id @default(cuid())
  academicProjectId String
  objectiveId      String
  researchQuestionId String?
  questionnaireItemId String?
  customQuestion   String?  // instrument-specific question text when not an RQ
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  objective        AcademicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  researchQuestion ResearchQuestion? @relation(fields: [researchQuestionId], references: [id], onDelete: SetNull)
  questionnaireItem QuestionnaireItem? @relation("QuestionItemObjectives", fields: [questionnaireItemId], references: [id], onDelete: SetNull)

  @@index([objectiveId])
  @@map("objective_questions")
}

model ResearchHypothesis {
  id               String   @id @default(cuid())
  academicProjectId String
  hypothesisType   String   // NULL, ALTERNATIVE
  statement        String
  variableIds      String   @default("[]") // JSON array of ResearchVariable ids
  status           String   @default("UNTESTED") // UNTESTED, SUPPORTED, REJECTED, PARTIALLY_SUPPORTED
  testedByAnalysisId String? // set only when a valid analysis exists
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  findings         Finding[]

  @@index([academicProjectId])
  @@map("research_hypotheses")
}

model ResearchVariable {
  id               String   @id @default(cuid())
  academicProjectId String
  name             String
  label            String?
  description      String?
  variableType     String?  // e.g. DEMOGRAPHIC_AGE, LIKERT_5, CONTINUOUS
  role             String   // INDEPENDENT, DEPENDENT, MODERATOR, MEDIATOR, CONTROL, DEMOGRAPHIC, OTHER
  measurementScale String?  // NOMINAL, ORDINAL, INTERVAL, RATIO
  operationalDefinition String?
  datasetColumnId  String?  // Data Lab linkage
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  datasetColumn    DatasetColumn? @relation(fields: [datasetColumnId], references: [id], onDelete: SetNull)
  questionnaireItems QuestionnaireItem[]
  frameworkNodes   ConceptualFrameworkNode[]

  @@unique([academicProjectId, name])
  @@index([academicProjectId])
  @@map("research_variables")
}

model ConceptualFramework {
  id               String   @id @default(cuid())
  academicProjectId String
  title            String
  description      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  nodes            ConceptualFrameworkNode[]
  edges            ConceptualFrameworkEdge[]

  @@index([academicProjectId])
  @@map("conceptual_frameworks")
}

model ConceptualFrameworkNode {
  id               String   @id @default(cuid())
  frameworkId      String
  variableId       String?
  concept          String
  description      String?
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  framework        ConceptualFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  variable         ResearchVariable? @relation(fields: [variableId], references: [id], onDelete: SetNull)
  sourceEdges      ConceptualFrameworkEdge[] @relation("EdgeSource")
  targetEdges      ConceptualFrameworkEdge[] @relation("EdgeTarget")

  @@index([frameworkId])
  @@map("conceptual_framework_nodes")
}

model ConceptualFrameworkEdge {
  id               String   @id @default(cuid())
  frameworkId      String
  sourceNodeId     String
  targetNodeId     String
  relationship     String   // CAUSES, INFLUENCES, CORRELATES_WITH, MEDIATES, MODERATES, ASSOCIATED_WITH
  description      String?
  createdAt        DateTime @default(now())

  framework        ConceptualFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  sourceNode       ConceptualFrameworkNode @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode       ConceptualFrameworkNode @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, sourceNodeId, targetNodeId, relationship])
  @@index([frameworkId])
  @@map("conceptual_framework_edges")
}

model Methodology {
  id               String   @id @default(cuid())
  academicProjectId String
  chapterId        String? @unique
  design           String?  // e.g. DESCRIPTIVE_SURVEY, EXPERIMENTAL, QUALITATIVE
  population       String?
  sampleSize       Int?
  samplingTechnique String?
  dataCollectionMethod String?
  analysisPlan     String?
  ethicalConsiderations String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  chapter          AcademicChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sections         MethodologySection[]

  @@index([academicProjectId])
  @@map("methodologies")
}

model MethodologySection {
  id               String   @id @default(cuid())
  methodologyId    String
  sectionKey       String   // RESEARCH_DESIGN, STUDY_AREA, POPULATION, SAMPLE, ...
  title            String
  content          String   @default("")
  order            Int      @default(0)
  status           String   @default("DRAFT") // DRAFT, AI_GENERATED, USER_EDITED, NEEDS_REVIEW, VERIFIED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  methodology      Methodology @relation(fields: [methodologyId], references: [id], onDelete: Cascade)

  @@unique([methodologyId, sectionKey])
  @@index([methodologyId])
  @@map("methodology_sections")
}

model InterviewGuide {
  id               String   @id @default(cuid())
  academicProjectId String
  title            String
  description      String?
  participantInfo  String?  // JSON: target participants, sampling notes
  consentNote      String?  // consent-related placeholder text
  status           String   @default("DRAFT") // DRAFT, AI_GENERATED, USER_EDITED, NEEDS_REVIEW, APPROVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  questions        InterviewQuestion[]
  appendices       AcademicAppendix[]

  @@index([academicProjectId])
  @@map("interview_guides")
}

model InterviewQuestion {
  id               String   @id @default(cuid())
  interviewGuideId String
  section          String?
  questionText     String
  probe            String?  // follow-up probe
  objectiveId      String?
  researchQuestionId String?
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  interviewGuide   InterviewGuide @relation(fields: [interviewGuideId], references: [id], onDelete: Cascade)

  @@index([interviewGuideId])
  @@map("interview_questions")
}

model Finding {
  id               String   @id @default(cuid())
  academicProjectId String
  number           Int      // finding number, e.g. 1
  statement        String
  interpretation   String?
  analysisId       String?  // provenance: analysis that produced this finding
  datasetId        String?  // provenance: dataset analysed
  tableId          String?  // provenance: Data Lab table
  chartId          String?  // provenance: Data Lab chart
  researchQuestionId String?
  objectiveId      String?
  hypothesisId     String?
  numericValue     Float?
  numericLabel     String?
  status           String   @default("DRAFT") // DRAFT, AI_GENERATED, USER_EDITED, NEEDS_REVIEW, VERIFIED
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  analysis         Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  dataset          Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  table            Table_? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  chart            Chart? @relation(fields: [chartId], references: [id], onDelete: SetNull)
  researchQuestion ResearchQuestion? @relation(fields: [researchQuestionId], references: [id], onDelete: SetNull)
  objective        AcademicObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  hypothesis       ResearchHypothesis? @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)
  conclusionLinks  ConclusionFinding[]
  recommendationLinks RecommendationFinding[]

  @@unique([academicProjectId, number])
  @@index([academicProjectId])
  @@map("findings")
}

model Conclusion {
  id               String   @id @default(cuid())
  academicProjectId String
  statement        String
  objectiveId      String?
  order            Int      @default(0)
  status           String   @default("DRAFT") // DRAFT, AI_GENERATED, USER_EDITED, NEEDS_REVIEW, VERIFIED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  objective        AcademicObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  findingLinks     ConclusionFinding[]

  @@index([academicProjectId])
  @@map("conclusions")
}

model ConclusionFinding {
  id               String   @id @default(cuid())
  conclusionId     String
  findingId        String
  createdAt        DateTime @default(now())

  conclusion       Conclusion @relation(fields: [conclusionId], references: [id], onDelete: Cascade)
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([conclusionId, findingId])
  @@map("conclusion_findings")
}

model Recommendation {
  id               String   @id @default(cuid())
  academicProjectId String
  statement        String
  audience         String?
  order            Int      @default(0)
  status           String   @default("DRAFT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  findingLinks     RecommendationFinding[]

  @@index([academicProjectId])
  @@map("recommendations")
}

model RecommendationFinding {
  id               String   @id @default(cuid())
  recommendationId String
  findingId        String
  createdAt        DateTime @default(now())

  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, findingId])
  @@map("recommendation_findings")
}

model AcademicAppendix {
  id               String   @id @default(cuid())
  academicProjectId String
  label            String   // e.g. "Appendix A"
  title            String
  appendixType     String   // QUESTIONNAIRE, INTERVIEW_GUIDE, CONSENT_FORM, RAW_DATA,
                             // ADDITIONAL_TABLE, ADDITIONAL_FIGURE, APPROVAL_LETTER,
                             // SUPPORTING_DOCUMENT
  chapterId        String?
  questionnaireId  String?
  interviewGuideId String?
  sourceId         String?  // bound to a real uploaded source
  datasetId        String?  // bound to a real Data Lab dataset
  tableId          String?  // bound to a real Data Lab table
  chartId          String?  // bound to a real Data Lab chart
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  chapter          AcademicChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  questionnaire    Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  interviewGuide   InterviewGuide? @relation(fields: [interviewGuideId], references: [id], onDelete: SetNull)
  source           Source?  @relation("AppendixBoundSource", fields: [sourceId], references: [id], onDelete: SetNull)
  dataset          Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  table            Table_? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  chart            Chart? @relation(fields: [chartId], references: [id], onDelete: SetNull)

  @@index([academicProjectId])
  @@map("academic_appendices")
}

model FrontMatter {
  id               String   @id @default(cuid())
  academicProjectId String
  kind             String   // COVER_PAGE, TITLE_PAGE, DECLARATION, CERTIFICATION, APPROVAL_PAGE,
                             // DEDICATION, ACKNOWLEDGEMENTS, ABSTRACT, TABLE_OF_CONTENTS,
                             // LIST_OF_TABLES, LIST_OF_FIGURES, LIST_OF_ABBREVIATIONS, LIST_OF_APPENDICES
  title            String
  content          String   @default("")
  required         Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)

  @@unique([academicProjectId, kind])
  @@index([academicProjectId])
  @@map("front_matter")
}

model AcademicAbstract {
  id               String   @id @default(cuid())
  academicProjectId String
  content          String   @default("")
  wordLimit        Int      @default(300)
  generationStatus String   @default("NONE") // NONE, AI_GENERATED, USER_EDITED
  reviewStatus     String   @default("DRAFT") // DRAFT, NEEDS_REVIEW, VERIFIED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)

  @@index([academicProjectId])
  @@map("academic_abstracts")
}

model AcademicTableFigure {
  id               String   @id @default(cuid())
  academicProjectId String
  kind             String   // TABLE, FIGURE
  number           Int      // e.g. 4.1 -> stored as sequence per kind
  label            String   // e.g. "Table 4.1"
  caption          String
  tableId          String?  // Data Lab table
  chartId          String?  // Data Lab chart
  documentSectionId String? @unique // where it appears
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  table            Table_? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  chart            Chart? @relation(fields: [chartId], references: [id], onDelete: SetNull)
  documentSection  DocumentSection? @relation(fields: [documentSectionId], references: [id], onDelete: SetNull)

  @@unique([academicProjectId, kind, number])
  @@index([academicProjectId])
  @@map("academic_tables_figures")
}

model AcademicReference {
  id               String   @id @default(cuid())
  academicProjectId String
  projectId        String
  citationId       String?  // bound to an existing Citation (source)
  style            String   @default("APA") // APA, MLA, CHICAGO, HARVARD
  authors          String   @default("[]") // JSON array
  year             String?
  title            String?
  source           String?  // journal / publisher / container
  volume           String?
  issue            String?
  pages            String?
  url              String?
  doi              String?
  raw              String
  isComplete       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citation         Citation? @relation(fields: [citationId], references: [id], onDelete: SetNull)

  @@index([academicProjectId])
  @@index([projectId])
  @@map("academic_references")
}

model ValidationRun {
  id               String   @id @default(cuid())
  academicProjectId String
  status           String   @default("COMPLETED") // COMPLETED, FAILED
  passedCount      Int      @default(0)
  warningCount     Int      @default(0)
  errorCount       Int      @default(0)
  createdAt        DateTime @default(now())

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  issues           ValidationIssue[]

  @@index([academicProjectId])
  @@map("validation_runs")
}

model ValidationIssue {
  id               String   @id @default(cuid())
  validationRunId  String
  category         String   // STRUCTURE, CONTENT, REFERENCE, DATA, FORMATTING
  severity         String   // PASS, WARNING, ERROR, NEEDS_REVIEW
  rule             String
  message          String
  entityId         String?  // chapter / section / block / reference / finding id
  entityType       String?
  resolved         Boolean  @default(false)
  resolutionNote   String?
  createdAt        DateTime @default(now())
  resolvedAt       DateTime?

  validationRun    ValidationRun @relation(fields: [validationRunId], references: [id], onDelete: Cascade)

  @@index([validationRunId])
  @@index([resolved])
  @@map("validation_issues")
}

model Questionnaire {
  id               String   @id @default(cuid())
  academicProjectId String
  title            String
  description      String?
  status           String   @default("DRAFT") // DRAFT, AI_GENERATED, USER_EDITED, NEEDS_REVIEW, APPROVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicProject  AcademicProject @relation(fields: [academicProjectId], references: [id], onDelete: Cascade)
  sections         QuestionnaireSection[]
  appendices       AcademicAppendix[]

  @@index([academicProjectId])
  @@map("questionnaires")
}

model QuestionnaireSection {
  id               String   @id @default(cuid())
  questionnaireId  String
  title            String
  description      String?
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  questionnaire    Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  items            QuestionnaireItem[]

  @@index([questionnaireId])
  @@map("questionnaire_sections")
}

model QuestionnaireItem {
  id               String   @id @default(cuid())
  questionnaireSectionId String
  variableId       String?
  questionNumber   String
  questionText     String
  questionType     String   // SHORT_TEXT, LONG_TEXT, SINGLE_CHOICE, MULTIPLE_CHOICE, YES_NO, LIKERT, NUMERIC, DATE, MATRIX
  responseOptions  String   @default("[]") // JSON array
  likertScale      String   @default("[]") // JSON array of scale points
  isRequired       Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questionnaireSection QuestionnaireSection @relation(fields: [questionnaireSectionId], references: [id], onDelete: Cascade)
  variable         ResearchVariable? @relation(fields: [variableId], references: [id], onDelete: SetNull)
  objectiveLinks   ObjectiveQuestion[] @relation("QuestionItemObjectives")

  @@unique([questionnaireSectionId, questionNumber])
  @@index([variableId])
  @@map("questionnaire_items")
}

model Table_ {
  id        String   @id @default(cuid())
  datasetId String
  title     String
  headers   String   @default("[]") // JSON array string
  rows      String   @default("[]") // JSON array string
  caption   String?
  note      String?
  createdAt DateTime @default(now())

  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  academicTables AcademicTableFigure[]
  appendices AcademicAppendix[]
  findings  Finding[]
  publicationFigures PublicationFigure[]

  @@index([datasetId])
  @@map("tables")
}

// ============================================================================
// AI PROVIDERS
// ============================================================================

model AIProvider {
  id           String   @id @default(cuid())
  name         String
  type         String   // GEMINI, OPENAI, OPENROUTER, OLLAMA, CUSTOM
  endpoint     String
  apiKeyId     String?
  capabilities String   @default("{}") // JSON string
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models_list  AIModel[]
  apiKeys      APIKey[]
  conversations AIConversation[]

  @@map("ai_providers")
}

model AIModel {
  id           String   @id @default(cuid())
  providerId   String
  name         String
  identifier   String
  capabilities String   @default("{}") // JSON string
  contextWindow Int
  maxTokens    Int?
  costPerToken String?  // JSON string
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider     AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_models")
}

model APIKey {
  id          String   @id @default(cuid())
  providerId  String
  keyName     String
  keyPrefix   String   // first 4 chars only
  keyValue    String?  // actual key value (stored encrypted in production)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("api_keys")
}

// ============================================================================
// TEMPLATES
// ============================================================================

model Template {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  description String?
  type        String   // DOCUMENT, SECTION, EXAM, QUESTIONNAIRE, REPORT
  projectType String   // project type this template applies to
  structure   String   @default("{}") // JSON string
  variables   String   @default("[]") // JSON array string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([projectType])
  @@map("templates")
}

// ============================================================================
// FORMATTING PROFILES
// ============================================================================

model FormattingProfile {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  description String?
  preset      String?  // APA, MLA, CHICAGO, etc.
  custom      String   @default("{}") // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  documents   Document[]
  academicProjects AcademicProject[]
  publications Publication[]

  @@index([projectId])
  @@map("formatting_profiles")
}

// ============================================================================
// GCE / EXAMINATION INTELLIGENCE
// ============================================================================

model ExamBoard {
  id          String   @id @default(cuid())
  name        String
  code        String?  // e.g. "CAMEROON_GCE", "CIE", "EDEXCEL"
  description String?
  metadata    String   @default("{}") // JSON: country, levels, website, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects    Subject[]
  syllabi     Syllabus[]
  pastPapers  PastPaper[]

  @@unique([name])
  @@map("exam_boards")
}

model Subject {
  id          String   @id @default(cuid())
  examBoardId String
  name        String
  code        String?  // e.g. "1123", "9709"
  level       String   @default("O_LEVEL") // O_LEVEL, A_LEVEL, etc.
  description String?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examBoard   ExamBoard  @relation(fields: [examBoardId], references: [id], onDelete: Cascade)
  syllabi     Syllabus[]
  pastPapers  PastPaper[]
  mockExams   MockExam[]

  @@unique([examBoardId, code])
  @@index([examBoardId])
  @@map("subjects")
}

model Syllabus {
  id          String   @id @default(cuid())
  projectId   String?
  examBoardId String
  subjectId   String
  title       String
  session     String?  // e.g. "2024", "2024-2026"
  version     String?
  sourceId    String?
  status      String   @default("DRAFT") // DRAFT, IMPORTED, REVIEWED, FINAL
  metadata    String   @default("{}") // JSON: extraction info, notes, page refs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  examBoard   ExamBoard         @relation(fields: [examBoardId], references: [id], onDelete: Cascade)
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  source      Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sections    SyllabusSection[]
  topics      SyllabusTopic[]

  @@index([examBoardId])
  @@index([projectId])
  @@map("syllabi")
}

model SyllabusSection {
  id          String   @id @default(cuid())
  syllabusId  String
  parentId    String?
  order       Int      @default(0)
  code        String?  // e.g. "1.1", "Unit 1"
  title       String
  description String?
  level       Int      @default(1) // hierarchy depth
  metadata    String   @default("{}") // source page ref, extraction info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  syllabus    Syllabus          @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  parent      SyllabusSection?  @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    SyllabusSection[] @relation("SectionHierarchy")
  topics      SyllabusTopic[]

  @@map("syllabus_sections")
}

model SyllabusTopic {
  id          String   @id @default(cuid())
  syllabusId  String
  sectionId   String?
  parentId    String?
  order       Int      @default(0)
  code        String?  // e.g. "1.1.2"
  title       String
  description String?
  level       Int      @default(1)
  metadata    String   @default("{}") // source page ref, source line ref, extraction info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  syllabus    Syllabus          @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  section     SyllabusSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent      SyllabusTopic?    @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    SyllabusTopic[]   @relation("TopicHierarchy")
  mappings    QuestionTopicMapping[]

  @@index([syllabusId])
  @@index([sectionId])
  @@index([parentId])
  @@map("syllabus_topics")
}

model PastPaper {
  id          String   @id @default(cuid())
  projectId   String
  examBoardId String
  subjectId   String
  year        Int
  session     String?  // e.g. "June", "November", "Annual"
  paperNumber String?  // e.g. "Paper 1", "11"
  title       String
  sourceId    String?
  status      String   @default("IMPORTED") // IMPORTED, PARSED, REVIEWED, ERROR
  metadata    String   @default("{}") // JSON: extraction info, page count, parsing status
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  examBoard   ExamBoard          @relation(fields: [examBoardId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  source      Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  questions   PastPaperQuestion[]
  markingSchemes MarkingScheme[]

  @@unique([examBoardId, subjectId, year, paperNumber])
  @@index([projectId])
  @@index([examBoardId])
  @@index([subjectId])
  @@index([year])
  @@map("past_papers")
}

model PastPaperQuestion {
  id               String   @id @default(cuid())
  pastPaperId      String
  questionNumber   String   @default("") // e.g. "1", "2(a)"
  subQuestionNumber String? // e.g. "(a)", "(i)"
  text             String   // full question text
  marks            Int      @default(0)
  questionType     String   @default("UNKNOWN") // MULTIPLE_CHOICE, SHORT_ANSWER, STRUCTURED, CALCULATION, ESSAY, DEFINITION, EXPLANATION, COMPARISON, DIAGRAM, DATA_INTERPRETATION
  commandVerb      String   @default("UNKNOWN") // DEFINE, EXPLAIN, CALCULATE, STATE, LIST, DESCRIBE, COMPARE, DISTINGUISH, DISCUSS, EVALUATE, ANALYZE, DRAW, IDENTIFY
  section          String?  // paper section name/number
  metadata         String   @default("{}") // JSON: position, source page, parsing confidence, review flags
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pastPaper        PastPaper            @relation(fields: [pastPaperId], references: [id], onDelete: Cascade)
  parts            QuestionPart[]
  markingPoints    MarkingPoint[]
  mappings         QuestionTopicMapping[]
  bankItems        QuestionBankItem[]
  mockQuestions    MockExamQuestion[]

  @@index([pastPaperId])
  @@index([questionNumber])
  @@map("past_paper_questions")
}

model QuestionPart {
  id        String   @id @default(cuid())
  questionId String
  label     String   @default("") // e.g. "(a)", "(i)", "A"
  text      String
  marks     Int      @default(0)
  order     Int      @default(0)
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  question  PastPaperQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_parts")
}

model MarkingScheme {
  id          String   @id @default(cuid())
  pastPaperId String
  sourceId    String?
  title       String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pastPaper   PastPaper      @relation(fields: [pastPaperId], references: [id], onDelete: Cascade)
  source      Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  points      MarkingPoint[]

  @@index([pastPaperId])
  @@map("marking_schemes")
}

model MarkingPoint {
  id               String   @id @default(cuid())
  markingSchemeId  String
  questionId       String?
  partLabel        String?  // which part of the question this point applies to
  pointText        String
  marks            Int      @default(0)
  order            Int      @default(0)
  metadata         String   @default("{}") // matching confidence, source info
  createdAt        DateTime @default(now())

  markingScheme    MarkingScheme       @relation(fields: [markingSchemeId], references: [id], onDelete: Cascade)
  question         PastPaperQuestion?  @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([markingSchemeId])
  @@index([questionId])
  @@map("marking_points")
}

model QuestionTopicMapping {
  id         String   @id @default(cuid())
  questionId String
  topicId    String
  method     String   @default("MANUAL") // KEYWORD, DETERMINISTIC, AI_SUGGESTED, MANUAL
  status     String   @default("SUGGESTED") // SUGGESTED, REVIEWED, CONFIRMED, REJECTED
  confidence Float?   // 0-1, when available
  rationale  String?  // explanation of why this mapping
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question   PastPaperQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic      SyllabusTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([questionId, topicId])
  @@index([questionId])
  @@index([topicId])
  @@index([status])
  @@map("question_topic_mappings")
}

model QuestionBankItem {
  id               String   @id @default(cuid())
  projectId        String
  sourceQuestionId String?  // PastPaperQuestion id if from historical paper
  questionText     String
  marks            Int      @default(0)
  topic            String?  // denormalized topic title for search/filter
  topicId          String?  // SyllabusTopic id
  questionType     String   @default("UNKNOWN")
  commandVerb      String   @default("UNKNOWN")
  difficulty       String   @default("UNKNOWN") // EASY, MEDIUM, HARD
  year             Int?
  paperTitle       String?
  sourceId         String?  // source file reference
  notes            String?
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceQuestion  PastPaperQuestion? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([topicId])
  @@index([questionType])
  @@index([commandVerb])
  @@map("question_bank_items")
}

model MockExam {
  id            String   @id @default(cuid())
  projectId     String
  subjectId     String
  title         String
  duration      Int?     // minutes
  totalMarks    Int      @default(0)
  configuration String   @default("{}") // JSON: instructions, sections, time allocation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions     MockExamQuestion[]

  @@index([projectId])
  @@index([subjectId])
  @@map("mock_exams")
}

model MockExamQuestion {
  id               String   @id @default(cuid())
  mockExamId       String
  sourceQuestionId String?  // PastPaperQuestion id
  questionBankItemId String? // QuestionBankItem id
  questionText     String   // snapshot of question text
  marks            Int      @default(0)
  order            Int      @default(0)
  metadata         String   @default("{}")
  createdAt        DateTime @default(now())

  mockExam         MockExam          @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  sourceQuestion   PastPaperQuestion? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  @@index([mockExamId])
  @@map("mock_exam_questions")
}

// ============================================================================
// GENERATION JOBS
// ============================================================================

model Transformation {
  id          String   @id @default(cuid())
  datasetId   String
  type        String   // RENAME_COLUMN, REMOVE_COLUMN, TRIM, CONVERT_TYPE, REPLACE_MISSING, REMOVE_DUPLICATES, FILTER_ROWS
  config      String   // JSON configuration
  resultDatasetId String?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  result      Dataset? @relation("TransformationResult", fields: [resultDatasetId], references: [id], onDelete: SetNull)

  @@index([datasetId])
  @@index([createdAt])
  @@map("transformations")
}

model GenerationJob {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // Job type
  status      String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  input       String   @default("{}") // JSON string
  output      String?  // JSON string
  error       String?
  progress    Int?     @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("generation_jobs")
}

// ============================================================================
// REVIEWS
