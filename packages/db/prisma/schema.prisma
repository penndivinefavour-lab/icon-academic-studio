// This is your Prisma schema file for ICON Academic Studio
// Uses PostgreSQL for both development and production.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  role          String   @default("USER") // ADMIN | USER
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaces    Workspace[]
  reviewItems   ReviewItem[]

  @@index([email])
  @@map("users")
}

// ============================================================================
// WORKSPACE
// ============================================================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@map("workspaces")
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   // GCE_STUDY_GUIDE, BOOK, THESIS, etc.
  workspaceId   String?
  settings      String   @default("{}") // JSON string
  status        String   @default("DRAFT") // DRAFT, IN_PROGRESS, REVIEW, COMPLETED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  sources       Source[]
  documents     Document[]
  datasets      Dataset[]
  researchNotes ResearchNote[]
  questions     Question[]
  researchQuestions ResearchQuestion[]
  templates     Template[]
  formattingProfiles FormattingProfile[]
  generationJobs GenerationJob[]

  @@index([workspaceId])
  @@index([type])
  @@map("projects")
}

// ============================================================================
// SOURCES
// ============================================================================

model Source {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  type             String   // PDF, DOCX, TXT, MARKDOWN, CSV, XLSX, IMAGE, WEB, NOTE, MANUAL
  mimeType         String?
  sizeBytes        Int
  filePath         String?
  contentPreview   String?
  metadata         String   @default("{}") // JSON string
  status           String   @default("UPLOADED") // UPLOADED, PROCESSING, PROCESSED, ERROR, DELETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks           SourceChunk[]
  citations        Citation[]
  evidenceItems    EvidenceItem[]

  @@index([projectId])
  @@index([status])
  @@map("sources")
}

model SourceChunk {
  id         String   @id @default(cuid())
  sourceId   String
  index      Int
  content    String
  metadata   String   @default("{}") // JSON string
  createdAt  DateTime @default(now())

  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_chunks")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id                    String   @id @default(cuid())
  projectId             String
  title                 String
  type                  String   // CHAPTER, SECTION, etc.
  structure             String   @default("{}") // JSON string
  settings              String   @default("{}") // JSON string
  status                String   @default("DRAFT") // DRAFT, REVIEW, EDITED, PROOF, TYPESET, FINAL
  version               Int      @default(1)
  wordCount             Int      @default(0)
  formattingProfileId   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formattingProfile     FormattingProfile? @relation(fields: [formattingProfileId], references: [id])
  reviewItems           ReviewItem[]
  exports               ExportJob[]

  @@index([projectId])
  @@index([status])
  @@map("documents")
}

// ============================================================================
// CITATIONS & REFERENCES
// ============================================================================

model Citation {
  id          String   @id @default(cuid())
  sourceId    String
  author      String?
  year        String?
  title       String?
  url         String?
  doi         String?
  pageRange   String?
  format      String   // INLINE, FOOTNOTE, ENDNOTE, BIBLIOGRAPHY
  raw         String
  verified    Boolean  @default(false)
  context     String?
  createdAt   DateTime @default(now())

  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("citations")
}

// ============================================================================
// RESEARCH
// ============================================================================

model ResearchNote {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  content         String
  tags            String   @default("[]") // JSON array string
  sources         String   @default("[]") // JSON array of source IDs
  linkedDocuments String   @default("[]") // JSON array of document IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_notes")
}

model ResearchQuestion {
  id          String   @id @default(cuid())
  projectId   String
  question    String
  hypothesis  String?
  status      String   @default("OPEN") // OPEN, INVESTIGATING, ANSWERED, CLOSED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]

  @@index([projectId])
  @@index([status])
  @@map("research_questions")
}

model EvidenceItem {
  id                 String   @id @default(cuid())
  researchQuestionId String
  sourceId           String
  claim              String
  supportingEvidence String
  strength           String   // STRONG, MODERATE, WEAK, UNCERTAIN
  createdAt          DateTime @default(now())

  researchQuestion   ResearchQuestion @relation(fields: [researchQuestionId], references: [id], onDelete: Cascade)
  source             Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([researchQuestionId])
  @@index([sourceId])
  @@map("evidence_items")
}

// ============================================================================
// DATASETS & ANALYSIS
// ============================================================================

model Dataset {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  file        String?  // JSON string
  columns     String   @default("[]") // JSON array string
  rowCount    Int      @default(0)
  preview     String   @default("[]") // JSON array string
  analysis    String?  // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
  charts      Chart[]
  tables      Table_[]

  @@index([projectId])
  @@map("datasets")
}

model Analysis {
  id          String   @id @default(cuid())
  datasetId   String
  method      String
  parameters  String   @default("{}") // JSON string
  results     String   @default("{}") // JSON string
  notes       String?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("analyses")
}

model Chart {
  id          String   @id @default(cuid())
  datasetId   String
  type        String   // BAR, LINE, PIE, etc.
  config      String   @default("{}") // JSON string
  data        String   @default("[]") // JSON array string
  imageUrl    String?
  title       String?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("charts")
}

model Table_ {
  id        String   @id @default(cuid())
  datasetId String
  title     String
  headers   String   @default("[]") // JSON array string
  rows      String   @default("[]") // JSON array string
  caption   String?
  note      String?
  createdAt DateTime @default(now())

  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("tables")
}

// ============================================================================
// AI PROVIDERS
// ============================================================================

model AIProvider {
  id           String   @id @default(cuid())
  name         String
  type         String   // GEMINI, OPENAI, OPENROUTER, OLLAMA, CUSTOM
  endpoint     String
  apiKeyId     String?
  capabilities String   @default("{}") // JSON string
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  models_list  AIModel[]
  apiKeys      APIKey[]

  @@map("ai_providers")
}

model AIModel {
  id           String   @id @default(cuid())
  providerId   String
  name         String
  identifier   String
  capabilities String   @default("{}") // JSON string
  contextWindow Int
  maxTokens    Int?
  costPerToken String?  // JSON string
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider     AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_models")
}

model APIKey {
  id          String   @id @default(cuid())
  providerId  String
  keyName     String
  keyPrefix   String   // first 4 chars only
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("api_keys")
}

// ============================================================================
// TEMPLATES
// ============================================================================

model Template {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  description String?
  type        String   // DOCUMENT, SECTION, EXAM, QUESTIONNAIRE, REPORT
  projectType String   // project type this template applies to
  structure   String   @default("{}") // JSON string
  variables   String   @default("[]") // JSON array string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([projectType])
  @@map("templates")
}

// ============================================================================
// FORMATTING PROFILES
// ============================================================================

model FormattingProfile {
  id          String   @id @default(cuid())
  projectId   String?
  name        String
  description String?
  preset      String?  // APA, MLA, CHICAGO, etc.
  custom      String   @default("{}") // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  documents   Document[]

  @@index([projectId])
  @@map("formatting_profiles")
}

// ============================================================================
// QUESTIONS & EXAMINATIONS
// ============================================================================

model Question {
  id            String   @id @default(cuid())
  projectId     String
  type          String   // MULTIPLE_CHOICE, SHORT_ANSWER, ESSAY, etc.
  subject       String
  topic         String
  subtopic      String?
  year          Int?
  paper         String?
  marks         Int
  difficulty    String   // EASY, MEDIUM, HARD, EXPERT
  stem          String
  options       String?  // JSON string
  answer        String?
  markingScheme String?  // JSON string
  sources       String   @default("[]") // JSON array string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([subject])
  @@index([topic])
  @@index([difficulty])
  @@map("questions")
}

model Syllabus {
  id       String   @id @default(cuid())
  subject  String
  examBoard String
  year     Int
  topics   String   @default("[]") // JSON array string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("syllabi")
}

// ============================================================================
// GENERATION JOBS
// ============================================================================

model GenerationJob {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // Job type
  status      String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  input       String   @default("{}") // JSON string
  output      String?  // JSON string
  error       String?
  progress    Int?     @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("generation_jobs")
}

// ============================================================================
// REVIEWS
// ============================================================================

model ReviewItem {
  id          String   @id @default(cuid())
  documentId  String
  blockId     String?
  type        String   // FACT_CHECK, GRAMMAR, STYLE, etc.
  status      String   @default("PENDING") // PENDING, ADDRESSED, RESOLVED, REJECTED
  reviewer    String?
  feedback    String
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [reviewer], references: [id])

  @@index([documentId])
  @@index([status])
  @@map("review_items")
}

// ============================================================================
// EXPORTS
// ============================================================================

model ExportJob {
  id          String   @id @default(cuid())
  documentId  String?
  datasetId   String?
  templateId  String?
  format      String   // DOCX, PDF, MARKDOWN, HTML, TXT
  status      String   @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  outputPath  String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  artifacts   ExportArtifact[]

  @@index([documentId])
  @@index([status])
  @@map("export_jobs")
}

model ExportArtifact {
  id         String   @id @default(cuid())
  jobId      String
  format     String
  path       String
  size       Int
  checksum   String
  createdAt  DateTime @default(now())

  job        ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("export_artifacts")
}

// ============================================================================
// AUDIT LOG (security)
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  changes     String?  // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
