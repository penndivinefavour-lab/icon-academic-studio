// This is your Prisma schema file for ICON Academic Studio
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaces    Workspace[]
  reviewItems   ReviewItem[]

  @@index([email])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// ============================================================================
// WORKSPACE
// ============================================================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@map("workspaces")
}

// ============================================================================
// PROJECTS
// ============================================================================

model Project {
  id            String         @id @default(cuid())
  name          String
  description   String?
  type          ProjectType
  workspaceId   String?
  settings      Json           @default("{}")
  status        ProjectStatus  @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  sources       Source[]
  documents     Document[]
  datasets      Dataset[]
  researchNotes ResearchNote[]
  questions     Question[]
  researchQuestions ResearchQuestion[]
  templates     Template[]
  formattingProfiles FormattingProfile[]
  generationJobs GenerationJob[]

  @@index([workspaceId])
  @@index([type])
  @@map("projects")
}

enum ProjectType {
  GCE_STUDY_GUIDE
  GCE_PAMPHLET
  PAST_PAPER_ANALYSIS
  REVISION_NOTES
  QUESTION_BANK
  MOCK_EXAMINATION
  TEXTBOOK
  BOOK
  RESEARCH_PROJECT
  HND_PROJECT
  THESIS
  RESEARCH_PROPOSAL
  SEMINAR_PAPER
  INTERNSHIP_REPORT
  QUESTIONNAIRE
  INTERVIEW_GUIDE
  DATA_ANALYSIS
  GENERAL_DOCUMENT
  CUSTOM
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

// ============================================================================
// SOURCES
// ============================================================================

model Source {
  id               String         @id @default(cuid())
  projectId        String
  name             String
  type             SourceType
  mimeType         String?
  sizeBytes        Int
  filePath         String?
  contentPreview   String?        @db.Text
  metadata         Json           @default("{}")
  status           SourceStatus   @default(UPLOADED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks           SourceChunk[]
  citations        Citation[]
  evidenceItems    EvidenceItem[]

  @@index([projectId])
  @@index([status])
  @@map("sources")
}

enum SourceType {
  PDF
  DOCX
  TXT
  MARKDOWN
  CSV
  XLSX
  IMAGE
  WEB
  NOTE
  MANUAL
}

enum SourceStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  ERROR
  DELETED
}

model SourceChunk {
  id         String   @id @default(cuid())
  sourceId   String
  index      Int
  content    String   @db.Text
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_chunks")
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  type        DocumentType
  structure   Json          @default("{}")
  settings    Json          @default("{}")
  status      DocumentStatus @default(DRAFT)
  version     Int           @default(1)
  wordCount   Int           @default(0)
  formattingProfileId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formattingProfile FormattingProfile? @relation(fields: [formattingProfileId], references: [id])
  reviewItems ReviewItem[]
  exports     ExportJob[]

  @@index([projectId])
  @@index([status])
  @@map("documents")
}

enum DocumentType {
  CHAPTER
  SECTION
  SUBSECTION
  PARAGRAPH
  APPENDIX
  PREFACE
  INTRODUCTION
  LITERATURE_REVIEW
  METHODOLOGY
  RESULTS
  DISCUSSION
  CONCLUSION
  REFERENCES
  BIBLIOGRAPHY
  GLOSSARY
  INDEX
  COVER
}

enum DocumentStatus {
  DRAFT
  REVIEW
  EDITED
  PROOF
  TYPESET
  FINAL
}

// ============================================================================
// CITATIONS & REFERENCES
// ============================================================================

model Citation {
  id          String      @id @default(cuid())
  sourceId    String
  author      String?
  year        String?
  title       String?
  url         String?
  doi         String?
  pageRange   String?
  format      CitationFormat
  raw         String      @db.Text
  verified    Boolean     @default(false)
  context     String?     @db.Text
  createdAt   DateTime    @default(now())

  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("citations")
}

enum CitationFormat {
  INLINE
  FOOTNOTE
  ENDNOTE
  BIBLIOGRAPHY
}

// ============================================================================
// RESEARCH
// ============================================================================

model ResearchNote {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  content     String    @db.Text
  tags        Json      @default("[]")
  sources     Json      @default("[]")
  linkedDocuments Json  @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_notes")
}

model ResearchQuestion {
  id          String                @id @default(cuid())
  projectId   String
  question    String                @db.Text
  hypothesis  String?               @db.Text
  status      ResearchQuestionStatus @default(OPEN)
  notes       String?               @db.Text
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]

  @@index([projectId])
  @@index([status])
  @@map("research_questions")
}

enum ResearchQuestionStatus {
  OPEN
  INVESTIGATING
  ANSWERED
  CLOSED
}

model EvidenceItem {
  id                 String           @id @default(cuid())
  researchQuestionId String
  sourceId           String
  claim              String           @db.Text
  supportingEvidence String           @db.Text
  strength           EvidenceStrength
  createdAt          DateTime         @default(now())

  researchQuestion   ResearchQuestion @relation(fields: [researchQuestionId], references: [id], onDelete: Cascade)
  source             Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([researchQuestionId])
  @@index([sourceId])
  @@map("evidence_items")
}

enum EvidenceStrength {
  STRONG
  MODERATE
  WEAK
  UNCERTAIN
}

// ============================================================================
// DATASETS & ANALYSIS
// ============================================================================

model Dataset {
  id          String     @id @default(cuid())
  projectId   String
  name        String
  description String?
  file        Json?
  columns     Json       @default("[]")
  rowCount    Int        @default(0)
  preview     Json       @default("[]")
  analysis    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
  charts      Chart[]
  tables      Table_[]

  @@index([projectId])
  @@map("datasets")
}

enum ColumnType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  CATEGORICAL
  ORDINAL
}

model Analysis {
  id          String   @id @default(cuid())
  datasetId   String
  method      String
  parameters  Json     @default("{}")
  results     Json     @default("{}")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("analyses")
}

model Chart {
  id          String    @id @default(cuid())
  datasetId   String
  type        ChartType
  config      Json      @default("{}")
  data        Json      @default("[]")
  imageUrl    String?
  title       String?
  createdAt   DateTime  @default(now())

  dataset     Dataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("charts")
}

enum ChartType {
  BAR
  LINE
  PIE
  SCATTER
  HISTOGRAM
  BOX_PLOT
}

model Table_ {
  id        String   @id @default(cuid())
  datasetId String
  title     String
  headers   Json     @default("[]")
  rows      Json     @default("[]")
  caption   String?
  note      String?  @db.Text
  createdAt DateTime @default(now())

  dataset   Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("tables")
}

// ============================================================================
// AI PROVIDERS
// ============================================================================

model AIProvider {
  id          String              @id @default(cuid())
  name        String
  type        AIProviderType
  endpoint    String
  apiKeyId    String?
  capabilities Json               @default("{}")
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  models      AIModel[]
  apiKeys     APIKey[]

  @@map("ai_providers")
}

enum AIProviderType {
  GEMINI
  OPENAI
  OPENROUTER
  OLLAMA
  CUSTOM
}

model AIModel {
  id           String         @id @default(cuid())
  providerId   String
  name         String
  identifier   String
  capabilities Json           @default("{}")
  contextWindow Int
  maxTokens    Int?
  costPerToken Json?
  isDefault    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  provider     AIProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("ai_models")
}

model APIKey {
  id          String   @id @default(cuid())
  providerId  String
  keyName     String
  keyPrefix   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("api_keys")
}

// ============================================================================
// TEMPLATES
// ============================================================================

model Template {
  id          String        @id @default(cuid())
  projectId   String?
  name        String
  description String?
  type        TemplateType
  projectType ProjectType
  structure   Json          @default("{}")
  variables   Json          @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([projectType])
  @@map("templates")
}

enum TemplateType {
  DOCUMENT
  SECTION
  EXAM
  QUESTIONNAIRE
  REPORT
}

// ============================================================================
// FORMATTING PROFILES
// ============================================================================

model FormattingProfile {
  id          String       @id @default(cuid())
  projectId   String?
  name        String
  description String?
  preset      FormattingPreset?
  custom      Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  documents   Document[]

  @@index([projectId])
  @@map("formatting_profiles")
}

enum FormattingPreset {
  APA
  MLA
  CHICAGO
  HARVARD
  IEEE
  GBT7714
  CUSTOM
}

// ============================================================================
// QUESTIONS & EXAMINATIONS
// ============================================================================

model Question {
  id          String      @id @default(cuid())
  projectId   String
  type        QuestionType
  subject     String
  topic       String
  subtopic    String?
  year        Int?
  paper       String?
  marks       Int
  difficulty  Difficulty
  stem        String     @db.Text
  options     Json?
  answer      String?    @db.Text
  markingScheme Json?
  sources     Json       @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([subject])
  @@index([topic])
  @@index([difficulty])
  @@map("questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
  CALCULATION
  CASE_STUDY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Syllabus {
  id          String   @id @default(cuid())
  subject     String
  examBoard   String
  year        Int
  topics      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("syllabi")
}

// ============================================================================
// GENERATION JOBS
// ============================================================================

model GenerationJob {
  id          String         @id @default(cuid())
  projectId   String
  type        JobType
  status      JobStatus      @default(PENDING)
  input       Json           @default("{}")
  output      Json?
  error       String?        @db.Text
  progress    Int?           @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("generation_jobs")
}

enum JobType {
  GENERATE_SECTION
  GENERATE_CHAPTER
  GENERATE_QUESTION
  ANALYZE_DATA
  EXTRACT_SOURCE
  FORMAT_DOCUMENT
  EXPORT_DOCUMENT
  REVIEW_CONTENT
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================================
// REVIEWS
// ============================================================================

model ReviewItem {
  id          String          @id @default(cuid())
  documentId  String
  blockId     String?
  type        ReviewType
  status      ReviewStatus    @default(PENDING)
  reviewer    String?
  feedback    String          @db.Text
  resolution  String?         @db.Text
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?

  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [reviewer], references: [id])

  @@index([documentId])
  @@index([status])
  @@map("review_items")
}

enum ReviewType {
  FACT_CHECK
  GRAMMAR
  STYLE
  CITATION
  CONTENT
  FORMATTING
}

enum ReviewStatus {
  PENDING
  ADDRESSED
  RESOLVED
  REJECTED
}

// ============================================================================
// EXPORTS
// ============================================================================

model ExportJob {
  id          String       @id @default(cuid())
  documentId  String?
  datasetId   String?
  templateId  String?
  format      ExportFormat
  status      ExportStatus @default(QUEUED)
  outputPath  String?
  error       String?      @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  document    Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  artifacts   ExportArtifact[]

  @@index([documentId])
  @@index([status])
  @@map("export_jobs")
}

enum ExportFormat {
  DOCX
  PDF
  MARKDOWN
  HTML
  TXT
}

enum ExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model ExportArtifact {
  id         String    @id @default(cuid())
  jobId      String
  format     ExportFormat
  path       String
  size       Int
  checksum   String
  createdAt  DateTime  @default(now())

  job        ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("export_artifacts")
}

// ============================================================================
// AUDIT LOG (security)
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
